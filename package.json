{
  "name": "army-vault",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ./scripts/run-next.cjs dev",
    "build": "node ./scripts/run-next.cjs build",
    "start": "node node_modules/next/dist/bin/next start",
    "lint": "node ./scripts/run-next.cjs lint",
    "gen:images": "node ./scripts/generate-product-images.cjs",
    "gen:images:missing": "node ./scripts/generate-product-images.cjs --missing-only --realistic-only",
    "gen:images:realistic": "node ./scripts/generate-product-images.cjs --realistic-only",
    "gen:images:fill": "node ./scripts/fill-ultra-real.cjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "next": "^15.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.8",
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "eslint": "^9.28.0",
    "eslint-config-next": "^15.3.3",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3"
  }
}
